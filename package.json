{
  "name": "shipping-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Logistics Shipping Platform Monorepo - .NET 10, Angular, AWS Target Architecture & Gherkin AI",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "dotnet run --project backend/Shipping.Api/Shipping.Api.csproj",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter web test",
    "test:all": "dotnet test backend/ShippingPlatform.sln && pnpm e2e",
    "lint": "pnpm --filter web lint",
    "e2e": "pnpm --filter e2e-tests test:e2e",
    "ghk:detect": "npx -y gherkin-ai@2.0.0-beta.1 detect",
    "ghk:generate": "npx -y gherkin-ai@2.0.0-beta.1 generate",
    "ghk:validate": "npx -y gherkin-ai@2.0.0-beta.1 validate",
    "ghk:context": "npx -y gherkin-ai@2.0.0-beta.1 context",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "gherkin-ai": "^2.0.0-beta.1"
  }
}
